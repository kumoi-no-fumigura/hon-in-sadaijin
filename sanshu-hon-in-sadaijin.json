   ],
   "lb": []
  },
  {
   "id": "sanshu-hon-in-sadaijin-0002",
   "pid": "1128193",
   "pages": [
    229
   ],
   "text": "一八〇つゆもおけとなびく物からたけのはのいろうつろへるあきもみぬかな右しをに(じ)あきのゝにいろなきつゆはおきしかどわかんらさきに花はそみけりときはぎちりかはる心なけれどみやまぎのときはゝ秋もしられざりけりあきはぎの花のながるゝかはのせにしがらみかくるしかのねもせぬ山たち花左あきごとにきりはふれどもあしびきのやまたち花はいろもかはらず右みねだにやすみうくならんあしびきのやまたち花のみやまゐ(第二紙)ひをせるもみぢ左つねよりもはやきもみぢばしらつゆのわきて心をおけるとやみんりむたうした草の花をみつればむらさきに秋さへふかくなりにけるかな(第三紙)(近衞家文書)右もみちばのながれてせけばやまがはゝあさきよりなほみづやひぬ覽たけ左",
   "poems": [
    "14",
    "15",
    "16",
    "17",
    "18",
    "19",
    "20",
    "21",
    "22"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "あきのこむとしのをゝのみくりかへしかぞへてうゑん草のいろ〓〓",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ゆめのみもかよへどあらぬありきちかうつゝにいかでみる",
   "kana": "",
   "speaker": "たけりむたう",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あきのゝの花はさきつゝうつろへどいつともわかぬやどのとこ夏",
   "kana": "",
   "speaker": "ワ",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "秋のゝをみるよりもな又あしびきの山となでしこさきにけるかな",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "なびくとや人はみるらんみなへしおもふかたにぞかぜもふきける",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "ひとしれずおひぬ物から花すゝきなどかあきしもほにはい",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "おほかたのゝべなるよりはをみなへしねやのつまにてみるはまされり",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "おぼつかなあきくるごとにふぢばかまたがためにとかつゆ",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "おくしもにいくしほそめてふぢばかまいまはかぎりとさき",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "しかのこゑたかさごやまのはぎなればをりてこしよりねをやなくらん",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "まねくかとみてたちよれば花すゝきうちふくかぜになびくなりけり",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "しらつゆにいろかはりゆくかるかやのほにいでゝあきをあはれとぞ思",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "よそめにはこともやすらにかるかやをなど秋風のふきみだるらん",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "つゆもおけとなびく物からたけのはのいろうつろへるあきもみぬかな",
   "kana": "",
   "speaker": "一八〇",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "あきのゝにいろなきつゆはおきしかどわかんらさきに花はそみけり",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ちりかはる心なけれどみやまぎのときはゝ秋もしられざりけり",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あきはぎの花のながるゝかはのせにしがらみかくるしかのねもせぬ",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "あきごとにきりはふれどもあしびきのやまたち花はいろもかはらず",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "みねだにやすみうくならんあしびきのやまたち花のみやまゐ",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "つねよりもはやきもみぢばしらつゆのわきて心をおけるとやみん",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "した草の花をみつればむらさきに秋さへふかくなりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "もみちばのながれてせけばやまがはゝあさきよりなほみづやひぬ覽",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  }
 ],
